# Application
APP_ENV=development
APP_NAME=AI 3D Digital Twin Security Camera
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# Database (SQLite for development; PostgreSQL-ready)
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/twin_security
DATABASE_URL=sqlite:///./data/twin_security.db

# Camera
CAMERA_ID=cam-1
CAMERA_SOURCE=0
TARGET_FPS=25
PROCESS_EVERY_N_FRAMES=2
MAX_INFERENCE_WIDTH=640
JPEG_QUALITY=75
MAX_UPLOAD_MB=200

# Detection / tracking
DETECTION_CONFIDENCE=0.5
OBJECT_CONFIDENCE=0.5
TRACKING_TIMEOUT=5

# Features
RECONSTRUCTION_ENABLED=true
AUDIO_ENABLED=false
DEMO_MODE=false
MODEL_DEVICE=auto

# Privacy
DATA_RETENTION_DAYS=7
IDENTITY_MODULE_ENABLED=false

# Auth-ready (disabled by default for local prototype)
AUTH_ENABLED=false
API_KEY=

# Optional model / API keys — never commit real values
# OPENAI_API_KEY=
# HUGGINGFACE_TOKEN=
